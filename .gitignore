# ---- 密钥与凭据：绝不允许进仓库 ----
.api_key
.url_secret
.webui_credentials
*.token
.github_token
.env
# 上面是精确名白名单，新增密钥文件忘了登记就会泄露。这两条通配兜底。
.*_secret
.*_key
# LLM Key。live-commerce/ 自己也有一份同样的规则，这里是纵深防御：
# 曾出过「修坏时的备份 llm_config.json.broken 同样含密钥却漏网」的事故，
# 故用通配把 .broken / .bak 一类备份一并挡住。
llm_config.json
llm_config.json.*
!llm_config.example.json

# ---- 运行时产物 ----
outputs/
uploads/
logs/
build/
voice_work/
script.json
script.built.json
*.mp4
*.wav
*.mp3

# ---- Python ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# ---- 模型权重：本仓库不含权重，见 README 第二节 ----
# GitHub 单文件上限 100MB，本项目有 30 个文件超过该限制
Linly-Talker/
checkpoints/
*.pth
*.pth.tar
*.safetensors
*.ckpt
*.onnx
*.bin
*.pt
!linly-api/app/static/*.html

# ---- 系统 ----
.DS_Store
Thumbs.db
